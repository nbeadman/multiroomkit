---
layout: base.njk
---
<article class="article wrap">
  <header class="article-header">
    <p class="eyebrow">{{ eyebrow }}{% if category %} <span>/</span> {{ category }}{% endif %}</p>
    <h1>{{ heading or title }}</h1>
    {% if summary %}<p class="article-summary">{{ summary }}</p>{% endif %}
  </header>
  <div class="prose">{{ content | safe }}</div>
</article>
