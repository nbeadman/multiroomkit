---
layout: base.njk
---
<section class="intro wrap">
  <div class="intro-copy">
    <p class="eyebrow">{{ eyebrow }} <span>/</span> {{ since }}</p>
    <h1>{% for line in headline %}{{ line }}<br>{% endfor %}<span>{{ headlineAccent }}</span></h1>
    <p class="lead">{{ lead }}</p>
    <div class="intro-detail">{{ content | safe }}</div>
  </div>
  <aside class="project-note" aria-label="Project status">
    <div class="note-top"><span>{{ project.identifier }}</span><span class="note-square" aria-hidden="true"></span></div>
    <p class="note-label">{{ project.label }}</p>
    <h2>{% for line in project.heading %}{{ line }}{% if not loop.last %}<br class="responsive-break"> {% endif %}{% endfor %}</h2>
    <div class="project-description">{{ project.body | renderContent("md") | safe }}</div>
    <dl><div><dt>Stage</dt><dd>{{ project.stage }}</dd></div><div><dt>Focus</dt><dd>{{ project.focus }}</dd></div></dl>
    <a href="{{ project.link }}">{{ project.linkLabel }} <span aria-hidden="true">↗</span></a>
  </aside>
</section>
<section class="journal wrap" aria-labelledby="journal-title">
  <div class="section-heading"><h2 id="journal-title">{{ journalHeading }}</h2><span>{{ collections.entries | length }} {% if collections.entries.length == 1 %}entry{% else %}entries{% endif %}</span></div>
  {% for entry in collections.entries %}
  <article class="journal-entry">
    <div class="entry-meta"><span class="entry-number">{{ entry.data.entryNumber }}</span><time datetime="{{ entry.date | isoDate }}">{{ entry.date | displayDate }}</time><span>{{ entry.data.category }}</span></div>
    <div class="entry-content"><h3><a href="{{ entry.url }}">{{ entry.data.title }}</a></h3><p>{{ entry.data.description }}</p><a class="text-link" href="{{ entry.url }}">Read entry <span aria-hidden="true">↗</span></a></div>
  </article>
  {% endfor %}
</section>
<section class="principles wrap" aria-labelledby="principles-title">
  <div><p class="eyebrow">{{ principles.label }}</p><h2 id="principles-title">{% for line in principles.heading %}{{ line }}{% if not loop.last %}<br class="responsive-break"> {% endif %}{% endfor %}</h2></div>
  <div class="principles-copy">{{ principles.body | renderContent("md") | safe }}</div>
</section>
